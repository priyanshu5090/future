<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>फ्यूचर (Future) : बिहार बोर्ड 10वीं संपूर्ण ऐप & AI मास्टर जी</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Hind:wght@400;600;700&display=swap');
    body { font-family: 'Hind', sans-serif; }

    @keyframes teacherFloat {
      0%, 100% { transform: translateY(0px) scale(1); }
      50% { transform: translateY(-6px) scale(1.02); }
    }
    .animate-masterji { animation: teacherFloat 3s ease-in-out infinite; }

    @keyframes speakingWave {
      0%, 100% { height: 6px; }
      50% { height: 22px; }
    }
    .voice-wave { animation: speakingWave 0.8s ease-in-out infinite; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 pb-24 select-none">

  <!-- ================= 0. REGISTRATION & OTP VERIFICATION SCREEN ================= -->
  <div id="authScreen" class="fixed inset-0 bg-slate-900/90 z-[100] flex items-center justify-center p-4 backdrop-blur-md overflow-y-auto">
    <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl border border-indigo-100 text-center space-y-4 my-auto">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-600 text-white flex items-center justify-center text-2xl mx-auto shadow-lg shadow-indigo-300">
        <i class="fa-solid fa-user-graduate"></i>
      </div>
      <div>
        <h2 class="text-lg font-bold text-slate-800">विद्यार्थी पंजीकरण (Registration)</h2>
        <p class="text-xs text-slate-500">फ्यूचर अध्ययन मंच पर अपना विवरण दर्ज करें</p>
      </div>

      <!-- Step A: Student Details -->
      <div id="phoneStep" class="space-y-3 text-left">
        <div>
          <label class="text-[11px] font-bold text-slate-600">विद्यार्थी का पूरा नाम</label>
          <div class="flex items-center border border-slate-300 rounded-xl px-3 py-2 mt-1 focus-within:ring-2 focus-within:ring-indigo-500 bg-slate-50">
            <i class="fa-solid fa-user text-slate-400 text-xs mr-2"></i>
            <input type="text" id="userNameInput" placeholder="अपना नाम लिखें" class="w-full bg-transparent text-xs text-slate-800 focus:outline-none font-semibold">
          </div>
        </div>

        <div>
          <label class="text-[11px] font-bold text-slate-600">मोबाइल नंबर (10 अंक)</label>
          <div class="flex items-center border border-slate-300 rounded-xl px-3 py-2 mt-1 focus-within:ring-2 focus-within:ring-indigo-500 bg-slate-50">
            <span class="text-xs font-bold text-slate-500 mr-2">+91</span>
            <input type="tel" id="userPhoneInput" maxlength="10" placeholder="10 अंकों का नंबर" class="w-full bg-transparent text-xs text-slate-800 focus:outline-none font-semibold">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-[11px] font-bold text-slate-600">राज्य (State)</label>
            <div class="flex items-center border border-slate-300 rounded-xl px-3 py-2 mt-1 focus-within:ring-2 focus-within:ring-indigo-500 bg-slate-50">
              <input type="text" id="userStateInput" placeholder="उदा: बिहार" class="w-full bg-transparent text-xs text-slate-800 focus:outline-none font-semibold">
            </div>
          </div>
          <div>
            <label class="text-[11px] font-bold text-slate-600">ज़िला (District)</label>
            <div class="flex items-center border border-slate-300 rounded-xl px-3 py-2 mt-1 focus-within:ring-2 focus-within:ring-indigo-500 bg-slate-50">
              <input type="text" id="userDistrictInput" placeholder="उदा: पटना" class="w-full bg-transparent text-xs text-slate-800 focus:outline-none font-semibold">
            </div>
          </div>
        </div>

        <button onclick="sendOTP()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2.5 rounded-xl text-xs font-bold shadow-md transition flex items-center justify-center gap-1.5 mt-2">
          <span>OTP कोड प्राप्त करें</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>

      <!-- Step B: OTP Verification -->
      <div id="otpStep" class="hidden space-y-3 text-left">
        <div class="bg-emerald-50 border border-emerald-200 p-2.5 rounded-xl flex items-center gap-2">
          <i class="fa-solid fa-envelope-open-text text-emerald-600 text-sm"></i>
          <div class="text-[11px] text-emerald-800">
            आपका सुरक्षित सत्यापन कोड: <strong id="generatedOtpBadge" class="text-xs font-bold text-emerald-950 tracking-wider">1234</strong>
          </div>
        </div>
        <div>
          <label class="text-[11px] font-bold text-slate-600">4-अंकों का OTP दर्ज करें</label>
          <input type="number" id="userOtpInput" maxlength="4" placeholder="4 अंकों का OTP" class="w-full border border-slate-300 rounded-xl px-3 py-2 mt-1 text-center text-sm font-bold tracking-widest text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50">
        </div>
        <button onclick="verifyOTP()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 rounded-xl text-xs font-bold shadow-md transition flex items-center justify-center gap-1.5">
          <i class="fa-solid fa-circle-check"></i>
          <span>सत्यापित करें एवं प्रवेश लें</span>
        </button>
        <button onclick="resetAuth()" class="w-full text-center text-[11px] text-slate-400 hover:text-slate-600">विवरण बदलें</button>
      </div>
    </div>
  </div>

  <!-- Top Header -->
  <header class="bg-indigo-700 text-white p-4 sticky top-0 z-50 shadow-md flex justify-between items-center">
    <div onclick="goHome()" class="cursor-pointer">
      <h1 class="text-xl font-bold flex items-center gap-2">
        <i class="fa-solid fa-graduation-cap text-amber-300"></i> फ्यूचर (Future)
      </h1>
      <p class="text-[11px] text-indigo-200">बिहार विद्यालय परीक्षा समिति • 10वीं संपूर्ण शिक्षण मंच</p>
    </div>
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1.5 bg-indigo-900/60 border border-indigo-400/30 px-2.5 py-1 rounded-full text-[11px]">
        <i class="fa-solid fa-user-check text-emerald-400"></i>
        <span class="text-indigo-100 font-semibold" id="headerUserName">विद्यार्थी</span>
      </div>
      <button onclick="logoutUser()" title="लॉगआउट" class="w-7 h-7 rounded-full bg-indigo-800/80 hover:bg-red-600 text-white flex items-center justify-center text-xs transition">
        <i class="fa-solid fa-right-from-bracket"></i>
      </button>
    </div>
  </header>

  <main class="max-w-2xl mx-auto p-4 space-y-4">

    <!-- Student Welcome Badge -->
    <div id="studentWelcomeBanner" class="bg-white px-4 py-2.5 rounded-xl border border-slate-200 flex justify-between items-center text-xs">
      <div>
        <span class="text-slate-500 font-medium">विद्यार्थी: </span>
        <strong id="displayStudentFullName" class="text-indigo-900 font-bold">छात्र</strong>
      </div>
      <div class="text-[11px] text-slate-500 font-medium">
        <i class="fa-solid fa-location-dot text-rose-500 mr-1"></i>
        <span id="displayStudentLocation">बिहार</span>
      </div>
    </div>

    <!-- Screen 1: Home Dashboard -->
    <section id="screenHome" class="space-y-4">

      <!-- Universal 3D Master Ji Live Help Desk -->
      <div class="bg-gradient-to-br from-indigo-900 via-indigo-800 to-violet-900 text-white p-4 rounded-2xl shadow-xl border border-indigo-500/40 relative overflow-hidden">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-14 h-14 rounded-2xl bg-amber-400 text-indigo-950 flex items-center justify-center text-3xl shadow-lg animate-masterji flex-shrink-0">
            👨‍🏫
          </div>
          <div>
            <h2 class="font-bold text-sm text-amber-300 flex items-center gap-1.5">
              <span>3D मास्टर जी (सर्वज्ञानी AI शिक्षक)</span>
              <span class="bg-emerald-500 text-white text-[9px] px-1.5 py-0.5 rounded-full font-sans">असीमित समाधान</span>
            </h2>
            <p class="text-[11px] text-indigo-200 leading-tight mt-0.5">10वीं का कोई भी विषय, कोई भी अध्याय या सामान्य ज्ञान का कोई भी सवाल यहाँ पूछें</p>
          </div>
        </div>
        <div class="flex gap-2">
          <input type="text" id="customQuestionInput" placeholder="किताब का कोई भी सवाल या डाउट यहाँ लिखें..." class="w-full px-3.5 py-2.5 rounded-xl text-slate-800 text-xs focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white shadow-inner font-medium">
          <button onclick="askMasterJiDirectly()" class="bg-amber-400 hover:bg-amber-500 text-indigo-950 font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-1.5 shadow-md flex-shrink-0">
            <i class="fa-solid fa-chalkboard-user"></i>
            <span>हल पाएँ</span>
          </button>
        </div>
      </div>

      <!-- Quick Feature Cards -->
      <div class="grid grid-cols-2 gap-3">
        <div onclick="openVocabHub()" class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm hover:border-indigo-400 cursor-pointer flex items-center gap-3 transition">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-amber-500 to-orange-600 text-white flex items-center justify-center text-lg shadow-sm">
            <i class="fa-solid fa-spell-check"></i>
          </div>
          <div>
            <h4 class="font-bold text-xs text-slate-800">1000+ शब्दकोश</h4>
            <span class="text-[10px] text-slate-500">उच्चारण एवं हिंदी अर्थ</span>
          </div>
        </div>

        <div onclick="openPhysicsLab()" class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm hover:border-cyan-400 cursor-pointer flex items-center gap-3 transition">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-cyan-600 to-blue-700 text-white flex items-center justify-center text-lg shadow-sm">
            <i class="fa-solid fa-atom"></i>
          </div>
          <div>
            <h4 class="font-bold text-xs text-slate-800">3D भौतिकी प्रयोगशाला</h4>
            <span class="text-[10px] text-emerald-600 font-semibold">🔴 परावर्तन प्रयोग</span>
          </div>
        </div>
      </div>

      <!-- BSEB 10th Subjects List -->
      <div>
        <div class="flex justify-between items-center mb-2.5">
          <h3 class="text-sm font-bold text-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-book-open-reader text-indigo-600"></i> बिहार बोर्ड 10वीं के सभी विषय
          </h3>
          <span class="text-[11px] text-indigo-600 font-semibold">सम्पूर्ण पाठ्यक्रम</span>
        </div>
        <div class="grid grid-cols-2 gap-2.5" id="subjectGrid"></div>
      </div>
    </section>

    <!-- Master Ji 3D Answer Modal -->
    <div id="aiTeacherModal" class="hidden fixed inset-0 bg-black/65 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
      <div class="bg-white w-full max-w-lg rounded-2xl p-5 shadow-2xl border border-indigo-100 max-h-[88vh] overflow-y-auto space-y-4">
        
        <div class="flex items-center justify-between border-b pb-3">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-indigo-100 border border-indigo-300 flex items-center justify-center text-2xl shadow animate-masterji flex-shrink-0">
              👨‍🏫
            </div>
            <div>
              <h3 class="font-bold text-sm text-indigo-950 flex items-center gap-1.5">
                <span>मास्टर जी की कक्षा</span>
                <span class="text-[10px] bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded font-semibold">सटीक व्याख्या</span>
              </h3>
              <p class="text-[10px] text-slate-500">शुद्ध हिंदी में धाराप्रवाह गुरुजन शैली</p>
            </div>
          </div>
          <button onclick="closeMasterJiModal()" class="text-slate-400 hover:text-slate-700 text-xl p-1">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
          <span class="text-[10px] font-bold text-indigo-600 uppercase tracking-wide">विद्यार्थी का प्रश्न:</span>
          <p id="modalQueryText" class="text-xs font-semibold text-slate-800 mt-0.5"></p>
        </div>

        <div class="bg-indigo-50/70 p-4 rounded-xl border border-indigo-200/80 leading-relaxed text-xs text-slate-800 space-y-3">
          <div class="flex items-center justify-between border-b border-indigo-200/50 pb-2">
            <span class="font-bold text-indigo-950 flex items-center gap-1">
              <i class="fa-solid fa-chalkboard-user text-indigo-600"></i> शिक्षक का विस्तृत उत्तर:
            </span>
            <div class="flex items-center gap-2">
              <div id="audioWaveBox" class="hidden flex items-end gap-0.5 h-5 px-2">
                <span class="w-1 bg-indigo-600 rounded-full voice-wave"></span>
                <span class="w-1 bg-indigo-600 rounded-full voice-wave" style="animation-delay: 0.2s"></span>
                <span class="w-1 bg-indigo-600 rounded-full voice-wave" style="animation-delay: 0.4s"></span>
              </div>
              <button id="modalAudioBtn" onclick="toggleModalSpeech()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1 rounded-full text-[11px] font-bold flex items-center gap-1.5 shadow">
                <i class="fa-solid fa-volume-high"></i>
                <span id="audioBtnText">सुनें</span>
              </button>
            </div>
          </div>
          <p id="modalAnswerText" class="font-normal text-slate-800 whitespace-pre-line leading-relaxed text-[12px]"></p>
        </div>

        <button onclick="closeMasterJiModal()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold shadow">
          धन्यवाद गुरुजी! समझ आ गया
        </button>
      </div>
    </div>

    <!-- Screen 2: Chapter Selector Screen -->
    <section id="screenChapters" class="hidden space-y-4">
      <div class="flex items-center justify-between">
        <button onclick="goHome()" class="text-indigo-600 font-semibold text-xs flex items-center gap-1">
          <i class="fa-solid fa-arrow-left"></i> मुख्य पृष्ठ
        </button>
        <h2 id="currentSubjectTitle" class="font-bold text-sm text-slate-800"></h2>
      </div>
      <div class="bg-indigo-50 border border-indigo-200 p-2.5 rounded-xl text-xs text-indigo-900 font-medium">
        📖 जिस अध्याय का अभ्यास करना चाहते हैं, उसका चयन करें:
      </div>
      <div id="chapterList" class="space-y-2"></div>
    </section>

    <!-- Screen 3: Test Engine -->
    <section id="screenTest" class="hidden space-y-4">
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex justify-between items-center text-xs font-semibold text-slate-500 mb-3">
          <span id="qIndexBadge">प्रश्न 1 / 2</span>
          <span class="bg-indigo-50 text-indigo-700 px-2.5 py-0.5 rounded-full font-bold">बिहार बोर्ड प्रारूप</span>
        </div>

        <h3 id="questionText" class="text-sm font-bold text-slate-900 mb-4 leading-relaxed"></h3>
        <div id="optionsContainer" class="space-y-2.5"></div>

        <div id="testTeacherFeedback" class="hidden mt-4 p-3 bg-amber-50 border border-amber-200 rounded-xl space-y-2">
          <div class="flex items-center justify-between text-xs font-bold text-amber-900">
            <span class="flex items-center gap-1.5">👨‍🏫 शिक्षक का चरणबद्ध हल:</span>
            <button onclick="speakInlineExplanation()" class="text-amber-900 bg-amber-200 hover:bg-amber-300 px-2.5 py-0.5 rounded text-[11px] flex items-center gap-1">
              <i class="fa-solid fa-volume-high"></i> सुनें
            </button>
          </div>
          <p id="inlineExplanationText" class="text-xs text-slate-700 leading-relaxed font-normal"></p>
        </div>

        <div class="mt-6 flex justify-between items-center pt-3 border-t border-slate-100">
          <button id="prevBtn" onclick="prevQuestion()" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 text-slate-600">पूर्व प्रश्न</button>
          <button id="nextBtn" onclick="nextQuestion()" class="px-4 py-1.5 text-xs font-semibold rounded-lg bg-indigo-600 text-white">अगला प्रश्न</button>
          <button id="finishBtn" onclick="finishTest()" class="hidden px-4 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 text-white">परीक्षा समाप्त करें</button>
        </div>
      </div>
    </section>

    <!-- Screen 4: 1000+ Vocabulary Bank Hub -->
    <section id="screenVocab" class="hidden space-y-4">
      <div class="flex items-center justify-between">
        <button onclick="goHome()" class="text-indigo-600 font-semibold text-xs flex items-center gap-1">
          <i class="fa-solid fa-arrow-left"></i> मुख्य पृष्ठ
        </button>
        <h2 class="font-bold text-sm text-slate-800">📖 1000+ अंग्रेजी शब्दकोश एवं व्याकरण</h2>
      </div>

      <div class="relative">
        <input type="text" id="vocabSearchInput" oninput="filterVocab(this.value)" placeholder="शब्द अथवा अर्थ खोजें (जैसे: Speak, Honest, Diligent)..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-indigo-500 bg-white">
        <i class="fa-solid fa-magnifying-glass absolute right-3.5 top-3 text-slate-400 text-xs"></i>
      </div>

      <div id="vocabListContainer" class="space-y-2 max-h-[65vh] overflow-y-auto pr-1"></div>
    </section>

    <!-- Screen 5: 3D Physics Lab -->
    <section id="screenPhysicsLab" class="hidden space-y-4">
      <div class="flex items-center justify-between">
        <button onclick="goHome()" class="text-indigo-600 font-semibold text-xs flex items-center gap-1">
          <i class="fa-solid fa-arrow-left"></i> मुख्य पृष्ठ
        </button>
        <h2 class="font-bold text-sm text-slate-800">🔬 3D भौतिकी प्रकाश प्रयोगशाला</h2>
      </div>

      <div class="bg-slate-900 rounded-2xl p-4 shadow-xl border border-slate-800 text-white space-y-3">
        <div class="flex justify-between items-center text-xs">
          <span class="text-amber-400 font-bold flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span> लेज़र किरण प्रदीप्त
          </span>
          <span class="bg-indigo-900/80 px-2 py-1 rounded text-cyan-300 font-mono text-[11px]" id="angleLiveBadge">
            ∠i = 45° | ∠r = 45°
          </span>
        </div>

        <div class="w-full h-48 bg-slate-950 rounded-xl relative overflow-hidden flex items-center justify-center border border-slate-800">
          <svg id="laserSvg" class="w-full h-full" viewBox="0 0 300 180">
            <rect x="20" y="150" width="260" height="8" fill="#38bdf8" rx="2" />
            <line x1="20" y1="158" x2="280" y2="158" stroke="#0284c7" stroke-width="2" stroke-dasharray="4,4" />
            <line x1="150" y1="30" x2="150" y2="150" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3,3" />
            <text x="154" y="45" fill="#94a3b8" font-size="10">अभिलंब (Normal)</text>

            <line id="incidentRay" x1="40" y1="40" x2="150" y2="150" stroke="#ef4444" stroke-width="3.5" stroke-linecap="round" />
            <line id="reflectedRay" x1="150" y1="150" x2="260" y2="40" stroke="#22c55e" stroke-width="3.5" stroke-linecap="round" />
            <circle cx="150" cy="150" r="4" fill="#fbbf24" />
          </svg>
        </div>

        <div class="space-y-2 pt-1">
          <div class="flex justify-between items-center text-xs">
            <span class="text-slate-300 font-semibold">आपतन कोण (Angle of Incidence):</span>
            <span id="angleValText" class="text-amber-400 font-bold font-mono">45°</span>
          </div>
          <input type="range" id="angleSlider" min="15" max="75" value="45" oninput="updateLaserAngle(this.value)" class="w-full accent-amber-400 cursor-pointer">
          <div class="grid grid-cols-2 gap-2 pt-1">
            <button onclick="changeAngle(-5)" class="bg-slate-800 hover:bg-slate-700 py-2 rounded-xl text-xs font-bold text-white border border-slate-700 flex items-center justify-center gap-1.5">
              <i class="fa-solid fa-minus text-amber-400"></i> कोण घटाएँ (-5°)
            </button>
            <button onclick="changeAngle(5)" class="bg-slate-800 hover:bg-slate-700 py-2 rounded-xl text-xs font-bold text-white border border-slate-700 flex items-center justify-center gap-1.5">
              <i class="fa-solid fa-plus text-amber-400"></i> कोण बढ़ाएँ (+5°)
            </button>
          </div>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-indigo-100 shadow-sm flex items-start gap-3">

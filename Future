        answer = "प्रिय विद्यार्थी, अंग्रेजी शब्द 'Speak' का ज्ञान:\n\n• शब्द: Speak (क्रिया - Verb)\n• हिंदी अर्थ: बोलना, कहना, बातचीत करना\n• Forms: Speak (V1), Spoke (V2), Spoken (V3)\n• वाक्य: Always speak politely and honestly.";
      }
      else if (hasWord('courage') || lower.includes('करेज')) {
        answer = "प्रिय विद्यार्थी, शब्द 'Courage':\n\n• व्याकरण: Noun (भाववाचक संज्ञा)\n• अर्थ: साहस, वीरता, आत्मबल\n• वाक्य: Courage is not the absence of fear, but victory over it.";
      }
      else if (hasWord('honest') || lower.includes('ऑनेस्ट')) {
        answer = "प्रिय विद्यार्थी, शब्द 'Honest':\n\n• व्याकरण: Adjective (विशेषण)\n• अर्थ: सत्यनिष्ठ, ईमानदार (H साइलेंट रहता है)\n• वाक्य: An honest person is respected by everyone.";
      }
      else if (hasWord('preposition') || (hasWord('in') && hasWord('on')) || lower.includes('प्रीपोजिशन')) {
        answer = "प्रिय विद्यार्थी, Preposition के सरल नियम:\n\n• In: बड़े नगर, देश, वर्ष या घिरे हुए स्थान के अंदर (In Bihar, In 2026, In the room).\n• On: किसी सतह को छूते हुए ऊपर (On the table) अथवा दिन/तारीख हेतु (On Monday).\n• With: किसी औजार/साधन से कार्य करने पर (Write with a pen) या साथ हेतु (With parents).";
      }

      // ===== 7. OUT OF SYLLABUS / GENERAL KNOWLEDGE / ANY OTHER TOPIC =====
      else if (lower.includes('कंप्यूटर') || lower.includes('इंटरनेट') || lower.includes('ai') || lower.includes('मोबाइल')) {
        answer = `प्रिय विद्यार्थी, तकनीक के विषय में समझिए:\n\n• कंप्यूटर एक इलेक्ट्रॉनिक यंत्र है जो इनपुट लेकर प्रोसेस करता है और आउटपुट प्रदान करता है। चार्ल्स बैबेज को कंप्यूटर का पिता कहा जाता है।\n• AI (आर्टिफिशियल इंटेलिजेंस) मशीनों में मानव जैसी बुद्धि और सोचने की क्षमता विकसित करने की तकनीक है, जिसका उपयोग आज शिक्षा और विज्ञान में हो रहा है।`;
      }
      else if (lower.includes('सूरज') || lower.includes('चांद') || lower.includes('पृथ्वी') || lower.includes('अंतरिक्ष') || lower.includes('तारा')) {
        answer = `प्रिय विद्यार्थी, खगोल विज्ञान का ज्ञान:\n\n• सूर्य हमारे सौरमंडल का केंद्र है और पृथ्वी का सबसे नजदीकी तारा है। यह मुख्यतः हाइड्रोजन और हीलियम गैसों से बना है।\n• पृथ्वी सूर्य की परिक्रमा 365.25 दिनों में पूरी करती है जिससे ऋतु परिवर्तन होता है, और अपनी धुरी पर 24 घंटे में घूमती है जिससे दिन-रात होते हैं।`;
      }
      else {
        // Universal Smart Concept Explainer for any miscellaneous query
        answer = `प्रिय विद्यार्थी, आपके प्रश्न "${q}" का शिक्षक समाधान:\n\nयह एक बहुत ही विचारणीय और ज्ञानवर्धक प्रश्न है। किसी भी विषय को समझने के लिए उसके तीन मुख्य आधार होते हैं:\n\n1. मूल संकल्पना: इस प्रश्न के पीछे जो मूल सिद्धांत अथवा कारण है, उसे ध्यान से पहचानें।\n2. वैज्ञानिक/तार्किक दृष्टिकोण: हर क्रिया का एक निश्चित नियम और प्रभाव होता है।\n3. अनुप्रयोग: इस ज्ञान का हमारे दैनिक जीवन और अध्ययन में सीधा उपयोग होता है।\n\nयदि यह प्रश्न आपके 10वीं बोर्ड के किसी विशिष्ट अध्याय से संबंधित है, तो संबंधित विषय का अध्याय टेस्ट देकर भी आप इसका पूरा स्टेप-बाय-स्टेप हल समझ सकते हैं। मन लगाकर पढ़ते रहिए, ज्ञान ही सबसे बड़ी शक्ति है!`;
      }

      document.getElementById('modalAnswerText').innerText = answer;
      document.getElementById('aiTeacherModal').classList.remove('hidden');
      speakCleanHindi(answer);
    }

    function closeMasterJiModal() {
      speechSynth.cancel();
      isSpeaking = false;
      document.getElementById('aiTeacherModal').classList.add('hidden');
    }

    // --- 4. 3D PHYSICS LAB ENGINE ---
    let currentLaserAngle = 45;

    function updateLaserAngle(val) {
      currentLaserAngle = parseInt(val);
      document.getElementById('angleValText').innerText = currentLaserAngle + "°";
      document.getElementById('angleLiveBadge').innerText = `∠i = ${currentLaserAngle}° | ∠r = ${currentLaserAngle}°`;
      document.getElementById('angleSlider').value = currentLaserAngle;

      const rad = (currentLaserAngle * Math.PI) / 180;
      const rayLen = 130;
      const dx = Math.sin(rad) * rayLen;
      const dy = Math.cos(rad) * rayLen;

      const incRay = document.getElementById('incidentRay');
      const refRay = document.getElementById('reflectedRay');
      if (incRay && refRay) {
        incRay.setAttribute('x1', 150 - dx);
        incRay.setAttribute('y1', 150 - dy);
        refRay.setAttribute('x2', 150 + dx);
        refRay.setAttribute('y2', 150 - dy);
      }

      const note = `उत्तम! आपने आपतन कोण ${currentLaserAngle}° निर्धारित किया है। परावर्तन के नियमानुसार परावर्तित किरण भी ठीक ${currentLaserAngle}° के कोण पर मुड़ रही है (∠i = ∠r = ${currentLaserAngle}°)।`;
      document.getElementById('labExplanationText').innerText = note;
    }

    function changeAngle(delta) {
      let next = currentLaserAngle + delta;
      if (next < 15) next = 15;
      if (next > 75) next = 75;
      updateLaserAngle(next);
      speakCleanHindi(document.getElementById('labExplanationText').innerText);
    }

    function speakLabExplanation() {
      speakCleanHindi(document.getElementById('labExplanationText').innerText);
    }

    // --- 5. UI NAVIGATION & TEST RUNNER ---
    function renderHome() {
      const grid = document.getElementById('subjectGrid');
      grid.innerHTML = SUBJECTS.map(s => `
        <div onclick="selectSubject('${s.id}', '${s.name}')" class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm hover:border-indigo-400 cursor-pointer flex items-center gap-2.5 transition">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-tr ${s.color} text-white flex items-center justify-center text-sm shadow-sm flex-shrink-0">
            <i class="fa-solid ${s.icon}"></i>
          </div>
          <div class="overflow-hidden">
            <h4 class="font-bold text-xs text-slate-800 truncate">${s.name}</h4>
            <span class="text-[10px] text-slate-500">सभी अध्याय उपलब्ध</span>
          </div>
        </div>
      `).join('');
    }

    function selectSubject(id, name) {
      hideAll();
      document.getElementById('screenChapters').classList.remove('hidden');
      document.getElementById('currentSubjectTitle').innerText = name;
      const list = CHAPTERS[id] || [{ id: 'm1', name: 'अध्याय 1: महत्वपूर्ण बोर्ड प्रश्न' }];
      document.getElementById('chapterList').innerHTML = list.map(c => `
        <div onclick="startTest('${c.id}')" class="p-3 bg-white rounded-xl border border-slate-200 hover:border-indigo-500 cursor-pointer flex justify-between items-center text-xs font-semibold text-slate-700 shadow-sm transition">
          <span>${c.name}</span>
          <i class="fa-solid fa-circle-play text-indigo-600 text-sm"></i>
        </div>
      `).join('');
    }

    let currentQuestions = [];
    let currentQIndex = 0;
    let userAnswers = {};

    function startTest(chId) {
      currentQuestions = QUESTIONS_DB[chId] || [
        { q: "इस अध्याय का महत्वपूर्ण बोर्ड प्रश्न: सही विकल्प का चुनाव करें।", opts: ["विकल्प क", "विकल्प ख (सही)", "विकल्प ग", "विकल्प घ"], correct: 1, note: "शिक्षक का हल: इस प्रश्न का सही उत्तर विकल्प ख है।" }
      ];
      currentQIndex = 0;
      userAnswers = {};
      hideAll();
      document.getElementById('screenTest').classList.remove('hidden');
      loadQuestion(0);
    }

    function loadQuestion(i) {
      const q = currentQuestions[i];
      document.getElementById('qIndexBadge').innerText = `प्रश्न ${i + 1} / ${currentQuestions.length}`;
      document.getElementById('questionText').innerText = q.q;

      const selected = userAnswers[i];
      document.getElementById('optionsContainer').innerHTML = q.opts.map((opt, idx) => {
        let cls = "p-3 rounded-xl border border-slate-200 cursor-pointer text-xs font-semibold flex items-center justify-between transition ";
        if (selected !== undefined) {
          if (idx === q.correct) cls += "bg-emerald-50 border-emerald-500 text-emerald-800";
          else if (selected === idx) cls += "bg-red-50 border-red-500 text-red-800";
          else cls += "bg-slate-50 opacity-50";
        } else {
          cls += "hover:bg-indigo-50 bg-white";
        }
        return `<div class="${cls}" onclick="pickOption(${idx})">
          <span>${String.fromCharCode(65 + idx)}. ${opt}</span>
        </div>`;
      }).join('');

      const fb = document.getElementById('testTeacherFeedback');
      if (selected !== undefined) {
        fb.classList.remove('hidden');
        document.getElementById('inlineExplanationText').innerText = q.note;
      } else {
        fb.classList.add('hidden');
      }

      document.getElementById('prevBtn').disabled = (i === 0);
      if (i === currentQuestions.length - 1) {
        document.getElementById('nextBtn').classList.add('hidden');
        document.getElementById('finishBtn').classList.remove('hidden');
      } else {
        document.getElementById('nextBtn').classList.remove('hidden');
        document.getElementById('finishBtn').classList.add('hidden');
      }
    }

    function pickOption(idx) {
      if (userAnswers[currentQIndex] !== undefined) return;
      userAnswers[currentQIndex] = idx;
      loadQuestion(currentQIndex);
      speakCleanHindi(currentQuestions[currentQIndex].note);
    }

    function speakInlineExplanation() {
      const txt = document.getElementById('inlineExplanationText').innerText;
      speakCleanHindi(txt);
    }

    function nextQuestion() { if (currentQIndex < currentQuestions.length - 1) { currentQIndex++; loadQuestion(currentQIndex); } }
    function prevQuestion() { if (currentQIndex > 0) { currentQIndex--; loadQuestion(currentQIndex); } }
    function finishTest() { alert("अभ्यास पूर्ण हुआ! आपका प्रयास सराहनीय है।"); goHome(); }

    function openVocabHub() {
      hideAll();
      document.getElementById('screenVocab').classList.remove('hidden');
      renderVocab(VOCAB_BANK);
    }

    function renderVocab(list) {
      const box = document.getElementById('vocabListContainer');
      box.innerHTML = list.map(v => `
        <div class="bg-white p-3 rounded-xl border border-slate-200 flex items-center justify-between shadow-sm">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-sm text-indigo-900">${v.word}</span>
              <span class="text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded">${v.pos}</span>
            </div>
            <div class="text-xs text-slate-700 font-medium mt-0.5">${v.meaning}</div>
            <div class="text-[11px] text-slate-400 italic mt-0.5">"${v.ex}"</div>
          </div>
          <button onclick="speakWord('${v.word}')" class="w-8 h-8 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white flex items-center justify-center transition">
            <i class="fa-solid fa-volume-high text-xs"></i>
          </button>
        </div>
      `).join('');
    }

    function filterVocab(val) {
      const q = val.toLowerCase();
      const filtered = VOCAB_BANK.filter(v => v.word.toLowerCase().includes(q) || v.meaning.includes(q));
      renderVocab(filtered);
    }

    function openPhysicsLab() { 
      hideAll(); 
      document.getElementById('screenPhysicsLab').classList.remove('hidden'); 
      updateLaserAngle(45);
    }

    function goHome() { 
      speechSynth.cancel();
      hideAll(); 
      document.getElementById('screenHome').classList.remove('hidden'); 
    }

    function hideAll() {
      ['screenHome', 'screenChapters', 'screenTest', 'screenVocab', 'screenPhysicsLab'].forEach(id => {
        document.getElementById(id).classList.add('hidden');
      });
    }

    // Launch App
    checkExistingAuth();
    renderHome();
  </script>
</body>
</html>

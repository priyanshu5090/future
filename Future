    // --- 2. CLEAN HINDI SPEECH SYNTHESIS ENGINE ---
    let speechSynth = window.speechSynthesis;
    let isSpeaking = false;

    function speakCleanHindi(text) {
      if (!('speechSynthesis' in window)) return;
      speechSynth.cancel();

      const cleaned = text
        .replace(/[*#_~]/g, '')
        .replace(/[•-]/g, ' ')
        .replace(/\n+/g, '। ');

      const utterance = new SpeechSynthesisUtterance(cleaned);
      utterance.lang = 'hi-IN';
      utterance.rate = 0.88;
      utterance.pitch = 0.95;

      utterance.onstart = () => {
        isSpeaking = true;
        const wave = document.getElementById('audioWaveBox');
        if (wave) wave.classList.remove('hidden');
        const btnText = document.getElementById('audioBtnText');
        if (btnText) btnText.innerText = "रोकें";
      };

      utterance.onend = () => {
        isSpeaking = false;
        const wave = document.getElementById('audioWaveBox');
        if (wave) wave.classList.add('hidden');
        const btnText = document.getElementById('audioBtnText');
        if (btnText) btnText.innerText = "सुनें";
      };

      utterance.onerror = () => {
        isSpeaking = false;
        const wave = document.getElementById('audioWaveBox');
        if (wave) wave.classList.add('hidden');
        const btnText = document.getElementById('audioBtnText');
        if (btnText) btnText.innerText = "सुनें";
      };

      speechSynth.speak(utterance);
    }

